---
import { Image } from 'astro:assets';
import profilePhoto from '../assets/images/site/profile/cycling.jpeg';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Ivo S. Vinklárek | Personal Academic Website',
	description = 'Personal academic website',
} = Astro.props;

const homePrefix = Astro.url.pathname === '/' ? '' : '/';

const sectionLinks = [
	{ href: `${homePrefix}#about`, label: 'About' },
	{ href: `${homePrefix}#research`, label: 'Research' },
	{ href: `${homePrefix}#projects`, label: 'Projects' },
	{ href: `${homePrefix}#cv`, label: 'CV' },
	{ href: `${homePrefix}#publications`, label: 'Publication List' },
	{ href: `${homePrefix}#blog`, label: 'Blog' },
	{ href: `${homePrefix}#links`, label: 'Links' },
	{ href: `${homePrefix}#contact`, label: 'Contact' },
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<div class="site-shell">
			<header class="mobile-profile" aria-label="Site profile">
				<div class="mobile-profile-row">
					<div class="profile-photo">
						<Image
							src={profilePhoto}
							alt="Portrait of Ivo S. Vinklárek wearing a cycling helmet"
							widths={[96, 192, 288]}
							sizes="86px"
							quality="high"
							class="profile-photo-image"
						/>
					</div>
					<div>
						<p class="profile-name"><a href="/">Ivo S. Vinklárek</a></p>
						<p class="profile-description">Personal academic website</p>
					</div>
				</div>
				<nav class="section-nav mobile-nav" aria-label="Homepage sections">
					<ul>
						{
							sectionLinks.map((link) => (
								<li>
									<a href={link.href}>{link.label}</a>
								</li>
							))
						}
					</ul>
				</nav>
			</header>

			<div class="content-column">
				<slot />
			</div>

			<aside class="site-sidebar" aria-label="Profile and section navigation">
				<div class="profile-photo">
					<Image
						src={profilePhoto}
						alt="Portrait of Ivo S. Vinklárek wearing a cycling helmet"
						widths={[160, 320, 480]}
						sizes="152px"
						quality="high"
						class="profile-photo-image"
					/>
				</div>
				<p class="profile-name"><a href="/">Ivo S. Vinklárek</a></p>
				<p class="profile-description">Personal academic website</p>
				<nav class="section-nav" aria-label="Homepage sections">
					<ul>
						{
							sectionLinks.map((link) => (
								<li>
									<a href={link.href}>{link.label}</a>
								</li>
							))
						}
					</ul>
				</nav>
			</aside>
		</div>

		<script>
			const sidebar = document.querySelector('.site-sidebar');
			const sidebarLinks = Array.from(
				document.querySelectorAll('.site-sidebar .section-nav a[href^="#"]'),
			);
			const navigationLinks = Array.from(
				document.querySelectorAll('.section-nav a[href^="#"]'),
			);
			const linkedSections = sidebarLinks
				.map((link) => {
					const href = link.getAttribute('href');
					return href ? document.querySelector(href) : null;
				})
				.filter(Boolean);
			let navigationTarget = null;
			let navigationFrame = 0;

			const setActiveSection = (activeSection) => {
				for (const link of sidebarLinks) {
					const isActive = link.getAttribute('href') === `#${activeSection?.id}`;
					link.classList.toggle('is-active', isActive);
					if (isActive) {
						link.setAttribute('aria-current', 'location');
					} else {
						link.removeAttribute('aria-current');
					}
				}
			};

			const updateActiveSection = () => {
				if (navigationTarget) {
					setActiveSection(navigationTarget);
					return;
				}

				const sidebarTop = sidebar ? Number.parseFloat(getComputedStyle(sidebar).top) : NaN;
				const readingLine = Number.isFinite(sidebarTop) ? sidebarTop : window.innerHeight * 0.16;
				let activeSection = linkedSections[0];

				for (const section of linkedSections) {
					if (section.getBoundingClientRect().top <= readingLine + 1) {
						activeSection = section;
					}
				}

				setActiveSection(activeSection);
			};

			const cancelNavigation = () => {
				if (!navigationFrame) return;
				window.cancelAnimationFrame(navigationFrame);
				navigationFrame = 0;
				navigationTarget = null;
				updateActiveSection();
			};

			const scrollToSection = (target) => {
				const scrollMargin = Number.parseFloat(getComputedStyle(target).scrollMarginTop) || 0;
				const startPosition = window.scrollY;
				const maximumPosition = document.documentElement.scrollHeight - window.innerHeight;
				const targetPosition = Math.min(
					Math.max(startPosition + target.getBoundingClientRect().top - scrollMargin, 0),
					maximumPosition,
				);
				const distance = targetPosition - startPosition;
				const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

				navigationTarget = target;
				setActiveSection(target);

				if (reduceMotion || Math.abs(distance) < 1) {
					window.scrollTo({ top: targetPosition, behavior: 'auto' });
					navigationTarget = null;
					updateActiveSection();
					return;
				}

				const duration = 320;
				let startTime;
				const step = (currentTime) => {
					startTime ??= currentTime;
					const progress = Math.min((currentTime - startTime) / duration, 1);
					const easedProgress = 1 - Math.pow(1 - progress, 3);
					window.scrollTo({ top: startPosition + distance * easedProgress, behavior: 'auto' });

					if (progress < 1) {
						navigationFrame = window.requestAnimationFrame(step);
						return;
					}

					navigationFrame = 0;
					navigationTarget = null;
					updateActiveSection();
				};

				navigationFrame = window.requestAnimationFrame(step);
			};

			for (const link of navigationLinks) {
				link.addEventListener('click', (event) => {
					if (
						event instanceof MouseEvent &&
						(event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey)
					) return;

					const href = link.getAttribute('href');
					const target = href?.startsWith('#') ? document.getElementById(href.slice(1)) : null;
					if (!href || !target) return;

					event.preventDefault();
					cancelNavigation();
					if (window.location.hash !== href) history.pushState(null, '', href);
					scrollToSection(target);
				});
			}

			updateActiveSection();
			window.addEventListener('scroll', updateActiveSection, { passive: true });
			window.addEventListener('wheel', cancelNavigation, { passive: true });
			window.addEventListener('touchstart', cancelNavigation, { passive: true });
			window.addEventListener('resize', () => {
				cancelNavigation();
				updateActiveSection();
			});
		</script>
	</body>
</html>

<style is:global>
	:root {
		--background: #ffffff;
		--surface: #f6f6f6;
		--text: #171717;
		--muted: #6a6a6a;
		--border: #dddddd;
		--accent: #404040;
		--surface-strong: #eeeeee;
		--content-width: 700px;
		--sidebar-width: 200px;
		--sidebar-gap: 2.5rem;
		--sidebar-top: 16vh;
		--page-padding: 1.5rem;

		color: var(--text);
		background: var(--background);
		font-family:
			ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI',
			sans-serif;
		font-size: 16px;
		line-height: 1.7;
	}

	* {
		box-sizing: border-box;
	}

	html {
		background: var(--background);
		scroll-behavior: auto;
	}

	body {
		margin: 0;
		min-width: 320px;
		background: var(--background);
		-webkit-font-smoothing: antialiased;
		text-rendering: optimizeLegibility;
	}

	a {
		color: var(--text);
		text-decoration-thickness: 1px;
		text-underline-offset: 0.18em;
	}

	a:hover {
		color: var(--accent);
	}

	p {
		margin: 0 0 1rem;
	}

	.site-shell {
		display: grid;
		grid-template-columns:
			minmax(calc(var(--sidebar-width) + var(--sidebar-gap)), 1fr)
			minmax(0, var(--content-width))
			minmax(calc(var(--sidebar-width) + var(--sidebar-gap)), 1fr);
		width: 100%;
		margin: 0;
		padding: 4rem var(--page-padding) 5rem;
		align-items: start;
	}

	.content-column {
		grid-column: 2;
		min-width: 0;
		padding-top: clamp(0rem, calc(var(--sidebar-top) - 4rem), 7rem);
	}

	.site-main {
		max-width: var(--content-width);
		padding-bottom: 60vh;
	}

	.site-section {
		padding: 0;
		margin: 0 0 3rem;
		scroll-margin-top: var(--sidebar-top);
	}

	.site-section:last-child {
		margin-bottom: 0;
	}

	.site-section h1,
	.site-section h2 {
		margin: 0 0 0.65rem;
		color: var(--text);
		font-weight: 620;
		line-height: 1.2;
		letter-spacing: 0;
	}

	.site-section h1 {
		font-size: 1.85rem;
	}

	.site-section h2 {
		font-size: 1.15rem;
	}

	.site-section p {
		max-width: 64ch;
		color: #343434;
	}

	.cv-summary {
		display: flex;
		align-items: baseline;
		width: fit-content;
		cursor: pointer;
		list-style: none;
	}

	.cv-summary::-webkit-details-marker {
		display: none;
	}

	.cv-summary::marker {
		content: '';
	}

	.cv-summary:focus-visible {
		border-radius: 0.15rem;
		outline: 2px solid var(--accent);
		outline-offset: 0.2rem;
	}

	.cv-arrow {
		margin-left: 0.4rem;
		color: var(--muted);
		font-size: 0.82rem;
		line-height: 1;
	}

	.cv-arrow-open,
	.cv-details[open] .cv-arrow-closed {
		display: none;
	}

	.cv-details[open] .cv-arrow-open {
		display: inline;
	}

	.site-sidebar {
		grid-column: 3;
		justify-self: start;
		position: sticky;
		top: var(--sidebar-top);
		width: var(--sidebar-width);
		margin-left: var(--sidebar-gap);
		padding: 1rem 1rem 1.1rem;
		border-radius: 0.4rem;
		background: var(--surface);
	}

	.mobile-profile {
		display: none;
	}

	.profile-photo {
		position: relative;
		width: 7rem;
		height: 7rem;
		margin: 0 0 1rem;
		padding: 0;
		overflow: hidden;
		border-radius: 50%;
		box-shadow: inset 0 0 0 1px var(--border);
	}

	.profile-photo-image {
		position: absolute;
		top: 50%;
		left: 50%;
		display: block;
		width: 135%;
		height: 135%;
		max-width: none;
		object-fit: cover;
		object-position: center;
		transform: translate(-50%, -44%);
	}

	.profile-name {
		margin: 0 0 0.15rem;
		color: var(--text);
		font-size: 0.98rem;
		font-weight: 550;
		line-height: 1.25;
	}

	.profile-name a {
		color: inherit;
		text-decoration: none;
	}

	.profile-name a:hover {
		text-decoration: underline;
	}

	.profile-description {
		margin: 0 0 1.45rem;
		color: var(--muted);
		font-size: 0.88rem;
		line-height: 1.45;
	}

	.section-nav {
		border-left: 1px solid var(--border);
		padding-left: 0.9rem;
	}

	.section-nav ul {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
		padding: 0;
		margin: 0;
		list-style: none;
	}

	.section-nav a {
		display: inline-block;
		position: relative;
		color: var(--muted);
		font-size: 0.9rem;
		line-height: 1.45;
		text-decoration: none;
	}

	.section-nav a:hover {
		color: var(--accent);
		text-decoration: underline;
	}

	.prose > :last-child {
		margin-bottom: 0;
	}

	.prose h2,
	.prose h3 {
		margin: 1.8rem 0 0.55rem;
		color: var(--text);
		font-weight: 620;
		line-height: 1.3;
	}

	.prose h2 {
		font-size: 1.05rem;
	}

	.prose h3 {
		font-size: 0.98rem;
	}

	.prose ul,
	.prose ol {
		padding-left: 1.25rem;
		margin: 0 0 1rem;
	}

	.prose li {
		margin-bottom: 0.3rem;
	}

	.prose strong {
		font-weight: 650;
	}

	.entry-list {
		display: grid;
		gap: 1.1rem;
		padding: 0;
		margin: 0 0 1rem;
		list-style: none;
	}

	.entry-list li {
		padding-bottom: 1.1rem;
		border-bottom: 1px solid var(--border);
	}

	.entry-list li:last-child {
		padding-bottom: 0;
		border-bottom: 0;
	}

	.entry-list h3 {
		margin: 0 0 0.15rem;
		font-size: 1rem;
		line-height: 1.4;
	}

	.entry-meta {
		margin: 0 0 0.25rem;
		color: var(--muted);
		font-size: 0.84rem;
	}

	.entry-description {
		margin: 0;
	}

	.status-label {
		display: inline-block;
		margin-left: 0.35rem;
		padding: 0.05rem 0.35rem;
		border: 1px solid var(--border);
		border-radius: 999px;
		color: var(--muted);
		font-size: 0.72rem;
		font-weight: 500;
		vertical-align: 0.08rem;
	}

	.text-link {
		font-size: 0.9rem;
	}

	.page-header {
		margin-bottom: 2rem;
	}

	.page-header h1 {
		margin: 0 0 0.35rem;
		font-size: 1.85rem;
		line-height: 1.2;
	}

	.page-description,
	.page-date {
		color: var(--muted);
	}

	.site-sidebar .section-nav a::before {
		position: absolute;
		top: 0.63em;
		left: -1.08rem;
		width: 0.35rem;
		height: 0.35rem;
		border-radius: 50%;
		background: transparent;
		content: '';
	}

	.site-sidebar .section-nav a.is-active,
	.site-sidebar .section-nav a[aria-current='location'] {
		color: var(--accent);
		font-weight: 650;
	}

	.site-sidebar .section-nav a.is-active::before,
	.site-sidebar .section-nav a[aria-current='location']::before {
		background: var(--accent);
	}

	@media (max-width: 760px) {
		:root {
			font-size: 16px;
		}

		.site-shell {
			display: block;
			padding: 1.5rem 1.15rem 3rem;
		}

		.site-sidebar {
			display: none;
		}

		.content-column {
			padding-top: 0;
		}

		.mobile-profile {
			display: block;
			padding-bottom: 1.35rem;
			margin-bottom: 2.25rem;
			border-bottom: 1px solid var(--border);
		}

		.mobile-profile-row {
			display: flex;
			align-items: center;
			gap: 1rem;
		}

		.mobile-profile .profile-photo {
			flex: 0 0 4rem;
			width: 4rem;
			height: 4rem;
			margin: 0;
		}

		.mobile-profile .profile-name {
			font-size: 1rem;
			font-weight: 600;
		}

		.mobile-profile .profile-description {
			font-size: 0.88rem;
			margin-bottom: 0;
		}

		.mobile-nav {
			margin-top: 1.1rem;
			padding-left: 0;
			border-left: 0;
		}

		.mobile-nav ul {
			flex-flow: row wrap;
			gap: 0.35rem 0.9rem;
		}

		.mobile-nav a {
			color: var(--text);
			font-size: 0.9rem;
		}

		.site-main {
			max-width: none;
			padding-bottom: 1rem;
		}

		.site-section {
			margin-bottom: 2.65rem;
			scroll-margin-top: 1.5rem;
		}

		.site-section h1 {
			font-size: 1.75rem;
		}
	}

	@media (min-width: 761px) and (max-width: 1228px) {
		.site-shell {
			grid-template-columns: minmax(0, var(--content-width)) var(--sidebar-width);
			column-gap: var(--sidebar-gap);
			width: min(
				100%,
				calc(
					var(--content-width) + var(--sidebar-gap) + var(--sidebar-width) +
						3rem
				)
			);
			margin: 0 auto;
		}

		.content-column,
		.site-sidebar {
			grid-column: auto;
		}

		.site-sidebar {
			margin-left: 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		html {
			scroll-behavior: auto;
		}
	}
</style>
