---
import BackLink from './BackLink.astro';

interface AdjacentPost {
	href: string;
	title: string;
}

interface Props {
	previous?: AdjacentPost;
	next?: AdjacentPost;
}

const { previous, next } = Astro.props;
---

<nav class="post-navigation" aria-label="Post navigation">
	<div class="post-navigation-side post-navigation-side--previous">
		{previous && <a href={previous.href} aria-label={`Previous post: ${previous.title}`}>← Previous post</a>}
	</div>
	<BackLink href="/blog/" label="Back to Blog" />
	<div class="post-navigation-side post-navigation-side--next">
		{next && <a href={next.href} aria-label={`Next post: ${next.title}`}>Next post →</a>}
	</div>
</nav>

<style>
	.post-navigation {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: start;
		gap: 1rem;
		padding-top: 1.25rem;
		margin-top: 2.5rem;
		border-top: 1px solid var(--border);
	}

	.post-navigation a {
		color: var(--muted);
		font-size: 0.9rem;
	}

	.post-navigation a:hover {
		color: var(--accent);
	}

	.post-navigation a:focus-visible {
		border-radius: 0.15rem;
		outline: 2px solid var(--accent);
		outline-offset: 0.2rem;
	}

	.post-navigation-side--next {
		text-align: right;
	}

	@media (max-width: 520px) {
		.post-navigation {
			grid-template-columns: 1fr 1fr;
		}

		.post-navigation > :global(.back-link) {
			grid-column: 1 / -1;
			grid-row: 1;
			justify-self: center;
		}
	}
</style>
