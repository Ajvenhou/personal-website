---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BlogHero from '../../components/BlogHero.astro';
import ImageGallery from '../../components/ImageGallery.astro';
import { blogMediaByPostId } from '../../data/blogImages';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((post) => ({
		params: { id: post.id },
		props: { post },
	}));
}

interface Props {
	post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content } = await render(post);
const blogMedia = blogMediaByPostId[post.id.toLowerCase()];
const hasOverlayTitle = Boolean(blogMedia?.hero.title);
const formattedDate = new Intl.DateTimeFormat('en-GB', {
	day: 'numeric',
	month: 'long',
	year: 'numeric',
}).format(post.data.date);
---

<Layout
	title={`${post.data.title} | Ivo S. Vinklárek`}
	description={post.data.description}
>
	<main class="site-main">
		<article>
			<header class:list={['page-header', { 'page-header--overlay-title': hasOverlayTitle }]}>
				<p><a class="text-link" href="/blog/">← Blog</a></p>
				{!hasOverlayTitle && <h1>{post.data.title}</h1>}
				<p class="page-date">
					{formattedDate}
					{post.data.draft && <span class="status-label">Draft</span>}
				</p>
				{!hasOverlayTitle && <p class="page-description">{post.data.description}</p>}
			</header>
			{blogMedia && <BlogHero {...blogMedia.hero} />}
			{hasOverlayTitle && <p class="page-description hero-description">{post.data.description}</p>}
			<div class="prose"><Content /></div>
			{
				blogMedia && (
					<ImageGallery
						images={blogMedia.gallery}
						label={`${post.data.title} photo gallery`}
						variant={blogMedia.galleryVariant}
						quality={blogMedia.galleryQuality}
					/>
				)
			}
		</article>
	</main>
</Layout>

<style>
	.page-header--overlay-title {
		margin-bottom: 0.85rem;
	}

	.page-header--overlay-title .page-date {
		margin-bottom: 0;
	}

	.hero-description {
		margin-bottom: 2rem;
	}
</style>
